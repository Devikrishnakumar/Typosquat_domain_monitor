# Fake Website Detector (Typosquad) Environment Configuration

# PostgreSQL Configuration
POSTGRES_DB=typosquat
POSTGRES_USER=typosquat_user
POSTGRES_PASSWORD=replace-with-a-secure-random-password

# Set a stable random JWT secret for persistent sessions and multi-worker deployments.
# Without JWT_SECRET, local API tokens expire when the process restarts.
# JWT Authentication Secret
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram Bot API Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP Alerting (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@fakewebsitedetector.local

# Certificate Transparency Configuration
CERTSTREAM_URL=wss://api.certstream.dev/lite
# For self-hosted Docker: CERTSTREAM_URL=ws://certstream-server:8081/full-stream
ENRICHMENT_WORKERS=4
MAX_PENDING_ENRICHMENTS=100

# Browser origins permitted to access the API
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
